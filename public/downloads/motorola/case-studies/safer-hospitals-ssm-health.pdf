   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">In the hospital operating room. An international team of professional surgeons and assistants works in a modern operating room. Professional doctors celebrate successfully saved lives.</rdf:li>
    </rdf:Alt>
   </dc:title>
